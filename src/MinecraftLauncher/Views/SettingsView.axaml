<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinecraftLauncher.ViewModels"
             x:Class="MinecraftLauncher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="30" Spacing="20">

            <TextBlock Text="⚙ Настройки"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#e94560"
                       Margin="0,0,0,10"/>

            <!-- Папка игры -->
            <Border Background="#16213e" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="📁 Папка игры (.minecraft)"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#e94560"/>
                    <TextBlock Text="Здесь хранятся все файлы игры: версии, моды, миры, скриншоты"
                               FontSize="12" Foreground="#8899aa"
                               TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*, 10, Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding GameDirectory}"
                                 Watermark="Путь к .minecraft"
                                 FontSize="13"/>
                        <Button Grid.Column="2"
                                Content="Обзор..."
                                Click="OnBrowseGameDirClick"
                                Padding="14,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Java -->
            <Border Background="#16213e" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="☕ Java Runtime"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#e94560"/>
                    <TextBlock Text="Minecraft требует Java 17+. Если авто-поиск не сработал — укажите путь вручную."
                               FontSize="12" Foreground="#8899aa"
                               TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*, 10, Auto, 10, Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding JavaPath}"
                                 Watermark="Путь к java.exe"
                                 FontSize="13"/>
                        <Button Grid.Column="2"
                                Content="Обзор..."
                                Click="OnBrowseJavaClick"
                                Padding="14,6"/>
                        <Button Grid.Column="4"
                                Content="Автопоиск"
                                Command="{Binding DetectJavaCommand}"
                                IsEnabled="{Binding !IsDetectingJava}"
                                Padding="14,6"/>
                    </Grid>
                    <TextBlock Text="{Binding JavaVersion, StringFormat='Версия: {0}'}"
                               FontSize="12" Foreground="#44ff44"/>
                </StackPanel>
            </Border>

            <!-- Память -->
            <Border Background="#16213e" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="💾 Память (RAM)"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#e94560"/>
                    <Grid ColumnDefinitions="*, 20, *">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Минимум (MB)"
                                       FontSize="12" Foreground="#8899aa"/>
                            <NumericUpDown Value="{Binding DefaultMinRam}"
                                           Minimum="256" Maximum="32768"
                                           Increment="256" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Максимум (MB)"
                                       FontSize="12" Foreground="#8899aa"/>
                            <NumericUpDown Value="{Binding DefaultMaxRam}"
                                           Minimum="512" Maximum="32768"
                                           Increment="512" FormatString="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Общие -->
            <Border Background="#16213e" CornerRadius="12" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="🎮 Общие"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#e94560"/>
                    <CheckBox IsChecked="{Binding ShowSnapshots}"
                              Content="Показывать snapshot-версии"
                              Foreground="#cccccc"/>
                    <CheckBox IsChecked="{Binding CloseLauncherOnGameStart}"
                              Content="Закрывать лаунчер при запуске игры"
                              Foreground="#cccccc"/>
                </StackPanel>
            </Border>

            <!-- Кнопки -->
            <Grid ColumnDefinitions="*, Auto, 10, Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="#44ff44"
                           VerticalAlignment="Center"
                           FontSize="12"/>
                <Button Grid.Column="1"
                        Content="↺ Сбросить"
                        Command="{Binding ResetToDefaultCommand}"
                        Padding="20,10"/>
                <Button Grid.Column="3"
                        Content="💾 Сохранить"
                        Command="{Binding SaveCommand}"
                        Background="#e94560"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="24,10"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>