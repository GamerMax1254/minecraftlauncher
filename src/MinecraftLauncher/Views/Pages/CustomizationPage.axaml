<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MinecraftLauncher.Views.Pages.CustomizationPage">

    <ScrollViewer>
        <StackPanel Margin="40,30" Spacing="20" MaxWidth="900">
            <TextBlock Text="Кастомизация" Classes="h1"/>
            <TextBlock Text="Настройка внешнего вида лаунчера"
                       Classes="body"/>

            <Border Classes="card">
                <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,20">
                    <TextBlock Text="🎨" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Скоро!"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Здесь появятся цветовые темы, фоновые изображения и настройки шрифтов"
                               Classes="body"
                               TextAlignment="Center"
                               MaxWidth="450"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>