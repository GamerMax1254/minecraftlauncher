<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinecraftLauncher.ViewModels.Pages"
             xmlns:models="using:MinecraftLauncher.Core.Models"
             x:Class="MinecraftLauncher.Views.Pages.HomePage"
             x:DataType="vm:HomePageViewModel">

    <Grid RowDefinitions="Auto, *, Auto">

        <Border Grid.Row="0" Padding="40,30,40,20">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Добро пожаловать!" Classes="h1"/>
                    <TextBlock Text="Выбери профиль и жми играть" 
                               Classes="body" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ПОСЛЕДНЯЯ ИГРА" Classes="label" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding LastPlayedText}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="40,10">
            <StackPanel Spacing="20" MaxWidth="900">

                <!-- Если нет профилей -->
                <Border Classes="card" 
                        IsVisible="{Binding !HasProfiles}">
                    <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,20">
                        <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="У вас пока нет профилей"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Перейдите на вкладку «Версии» чтобы создать первый профиль"
                                   Classes="body"
                                   TextAlignment="Center"
                                   MaxWidth="400"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Основная карточка -->
                <Border Classes="card" IsVisible="{Binding HasProfiles}">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="*, 20, *">
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="ИГРОК" Classes="label"/>
                                <TextBox Text="{Binding Username}"
                                         Watermark="Введите ник..."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="8">
                                <TextBlock Text="ПРОФИЛЬ" Classes="label"/>
                                <ComboBox ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedProfile}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="models:GameProfile">
                                            <Grid ColumnDefinitions="Auto, 10, *, Auto">
                                                <Border Grid.Column="0"
                                                        Background="{Binding LoaderColor}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayLoader}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding MinecraftVersion}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Button Content="▶  ИГРАТЬ"
                                Classes="primary"
                                Command="{Binding LaunchCommand}"
                                IsEnabled="{Binding !IsLaunching}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontSize="16"
                                Padding="0,14"/>
                    </StackPanel>
                </Border>

                <!-- Прогресс -->
                <Border Classes="card" 
                        IsVisible="{Binding ShowProgress}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding StatusText}"
                                       FontSize="13"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProgressValue, StringFormat={}{0:F0}%}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProgressValue}" Maximum="100"/>
                        <TextBlock Text="{Binding ProgressDetail}"
                                   Classes="caption"
                                   IsVisible="{Binding ProgressDetail.Length}"/>
                    </StackPanel>
                </Border>

                <!-- Плитки -->
                <Grid ColumnDefinitions="*, 16, *" IsVisible="{Binding HasProfiles}">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="📊" FontSize="24"/>
                            <TextBlock Text="Статистика" Classes="h3"/>
                            <TextBlock Text="Отслеживай время игры и достижения (скоро)"
                                       Classes="body"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🧩" FontSize="24"/>
                            <TextBlock Text="Моды" Classes="h3"/>
                            <TextBlock Text="Устанавливай моды через Fabric/Forge (скоро)"
                                       Classes="body"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <TextBlock Text="{Binding StatusText}" Classes="caption"/>
        </Border>
    </Grid>
</UserControl>