<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinecraftLauncher.ViewModels.Pages"
             xmlns:models="using:MinecraftLauncher.Core.Models"
             x:Class="MinecraftLauncher.Views.Pages.CreateProfileDialogView"
             x:DataType="vm:CreateProfileDialogViewModel">

    <StackPanel Spacing="16">

        <TextBlock Text="Новый профиль" Classes="h2"/>

        <StackPanel Spacing="6">
            <TextBlock Text="ЗАГРУЗЧИК" Classes="label"/>
            <ComboBox ItemsSource="{Binding AvailableLoaders}"
                      SelectedItem="{Binding SelectedLoader}"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <CheckBox IsChecked="{Binding IncludeSnapshots}"
                  Content="Показывать snapshot-версии"/>

        <StackPanel Spacing="6">
            <TextBlock Text="ВЕРСИЯ MINECRAFT" Classes="label"/>
            <ComboBox ItemsSource="{Binding AvailableVersions}"
                      SelectedItem="{Binding SelectedVersion}"
                      HorizontalAlignment="Stretch"
                      IsEnabled="{Binding !IsLoading}"
                      PlaceholderText="Загрузка..."/>
        </StackPanel>

        <StackPanel Spacing="6"
                    IsVisible="{Binding IsLoaderVersionVisible}">
            <TextBlock Text="ВЕРСИЯ ЗАГРУЗЧИКА" Classes="label"/>
            <ComboBox ItemsSource="{Binding AvailableLoaderVersions}"
                      SelectedItem="{Binding SelectedLoaderVersion}"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="ИМЯ ПРОФИЛЯ" Classes="label"/>
            <TextBox Text="{Binding ProfileName}"
                     Watermark="Например: Моя ваниль"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <CheckBox IsChecked="{Binding IsolatedGameDir}"
                      Content="Изолированная папка (свои моды, миры, конфиги)"/>
            <TextBlock Text="Рекомендуется для модовых сборок. Для vanilla можно выключить чтобы шарить миры."
                       Classes="caption"
                       TextWrapping="Wrap"
                       Margin="24,0,0,0"/>
        </StackPanel>

        <Border IsVisible="{Binding ErrorText.Length}"
                Background="#3a1520"
                BorderBrush="{StaticResource AccentDangerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <TextBlock Text="{Binding ErrorText}"
                       Foreground="{StaticResource AccentDangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid ColumnDefinitions="*, 10, *" Margin="0,10,0,0">
            <Button Grid.Column="0"
                    Content="Отмена"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>
            <Button Grid.Column="2"
                    Content="Создать"
                    Classes="primary"
                    Command="{Binding CreateCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>
        </Grid>
    </StackPanel>
</UserControl>
