<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinecraftLauncher.ViewModels.Pages"
             xmlns:models="using:MinecraftLauncher.Core.Models"
             x:Class="MinecraftLauncher.Views.Pages.VersionsPage"
             x:DataType="vm:VersionsPageViewModel">

    <Grid>
        <!-- Основной контент -->
        <Grid RowDefinitions="Auto, *, Auto">

            <Border Grid.Row="0" Padding="40,30,40,20">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Профили" Classes="h1"/>
                        <TextBlock Text="Установленные версии и модпаки"
                                   Classes="body" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="+ Создать профиль"
                            Classes="primary"
                            Command="{Binding OpenCreateDialogCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="40,0">
                <StackPanel Spacing="10" Margin="0,0,0,20">

                    <!-- Пусто -->
                    <Border Classes="card"
                            IsVisible="{Binding !Profiles.Count}">
                        <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,30">
                            <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="Профилей пока нет"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Нажмите «+ Создать профиль» чтобы установить первую версию Minecraft"
                                       Classes="body"
                                       TextAlignment="Center"
                                       MaxWidth="400"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Список профилей -->
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:GameProfile">
                                <Border Classes="card" Margin="0,0,0,10" Padding="16">
                                    <Grid ColumnDefinitions="Auto, 16, *, Auto">

                                        <Border Grid.Column="0"
                                                Background="{Binding LoaderColor}"
                                                Width="48" Height="48"
                                                CornerRadius="8"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="⛏"
                                                       FontSize="22"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border CornerRadius="4"
                                                        Background="{Binding LoaderColor}"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding DisplayLoader}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding MinecraftVersion}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PlayCount, StringFormat='Запусков: {0}'}"
                                                           Classes="caption"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Content="▶ Играть"
                                                    Classes="primary"
                                                    Command="{Binding $parent[ItemsControl].((vm:VersionsPageViewModel)DataContext).LaunchCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="🗑"
                                                    Classes="ghost"
                                                    Command="{Binding $parent[ItemsControl].((vm:VersionsPageViewModel)DataContext).DeleteProfileCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Удалить профиль"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="40,10">
                <TextBlock Text="{Binding StatusText}" Classes="caption"/>
            </Border>
        </Grid>

        <!-- ============ МОДАЛЬНОЕ ОКНО ============ -->
        <Border IsVisible="{Binding ShowCreateDialog}"
                Background="#B0000000">
            <Border MaxWidth="500"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <ContentControl Content="{Binding CreateDialog}"/>
            </Border>
        </Border>
    </Grid>
</UserControl>