<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MinecraftLauncher.ViewModels"
        x:Class="MinecraftLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Minecraft Launcher"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="240, *">

        <!-- ============ САЙДБАР ============ -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto">

                <!-- Логотип -->
                <Border Grid.Row="0"
                        Padding="20,24,20,20"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource AccentPrimaryBrush}"
                                Width="36" Height="36"
                                CornerRadius="8">
                            <TextBlock Text="⛏"
                                       FontSize="20"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MC Launcher"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="v0.1.0"
                                       FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Навигация -->
                <ScrollViewer Grid.Row="1" Padding="12,16">
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PageViewModelBase">
                                <Button Classes="nav"
                                        Margin="0,0,0,4"
                                        Classes.active="{Binding $parent[Window].((vm:MainViewModel)DataContext).CurrentPage, 
                                                          Converter={StaticResource EqualityConverter}, 
                                                          ConverterParameter={Binding}}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Нижний блок -->
                <Border Grid.Row="2"
                        Padding="16,14"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="OFFLINE MODE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   LetterSpacing="1"
                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                        <TextBlock Text="Не авторизован"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ КОНТЕНТ ============ -->
        <Border Grid.Column="1" Background="{StaticResource BgBaseBrush}">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>
    </Grid>
</Window>