<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinecraftLauncher"
             xmlns:conv="using:MinecraftLauncher.Converters"
             x:Class="MinecraftLauncher.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <conv:EqualityConverter x:Key="EqualityConverter"/>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://MinecraftLauncher/Styles/Theme.axaml"/>
    </Application.Styles>
</Application>